{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentAI — Company Service API",
    "description": "Microservice quản lý hồ sơ doanh nghiệp (Company Profile), quy trình xác minh doanh nghiệp (Verification), danh mục ngành nghề (Industries), và địa điểm (Locations) trên nền tảng tuyển dụng TalentAI.",
    "contact": {
      "name": "TalentAI Backend Team",
      "email": "backend@talentai.dev"
    },
    "license": {
      "name": "Private",
      "url": "https://talentai.dev"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Local Development"
    },
    {
      "url": "http://localhost:3000",
      "description": "API Gateway Routing"
    }
  ],
  "paths": {
    "/api/v1/locations": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Lấy danh mục địa điểm",
        "description": "Danh sách tất cả các tỉnh/thành phố, địa điểm làm việc",
        "operationId": "locations",
        "responses": {
          "200": {
            "description": "Danh sách địa điểm",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListLocationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/industries": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Lấy danh mục ngành nghề",
        "description": "Danh sách tất cả các ngành nghề kinh doanh/hoạt động",
        "operationId": "industries",
        "responses": {
          "200": {
            "description": "Danh sách ngành nghề",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListIndustryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Tìm kiếm danh sách công ty công khai",
        "description": "Tìm kiếm các công ty đã đăng ký trên hệ thống theo từ khóa, ngành nghề, địa điểm và phân trang",
        "operationId": "searchCompanies",
        "parameters": [
          {
            "name": "request",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CompanySearchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách kết quả tìm kiếm phân trang",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageCompanySearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Xem thông tin chi tiết một công ty",
        "description": "Tra cứu thông tin công khai của doanh nghiệp theo ID",
        "operationId": "getPublic",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID của công ty",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết công ty",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy công ty với ID đã cung cấp",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseListLocationResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationResponse"
            }
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "ApiResponseListIndustryResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndustryResponse"
            }
          }
        }
      },
      "IndustryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CompanySearchRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "industryId": {
            "type": "integer",
            "format": "int64"
          },
          "locationId": {
            "type": "integer",
            "format": "int64"
          },
          "minSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "maxSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 1
          }
        }
      },
      "PageCompanySearchResponse": {
        "type": "object",
        "properties": {
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanySearchResponse"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "CompanySearchResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "companySize": {
            "type": "integer",
            "format": "int32"
          },
          "address": {
            "type": "string"
          },
          "industryId": {
            "type": "integer",
            "format": "int64"
          },
          "locationId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SortObject": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean"
          },
          "sorted": {
            "type": "boolean"
          },
          "unsorted": {
            "type": "boolean"
          }
        }
      },
      "PageableObject": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "paged": {
            "type": "boolean"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "unpaged": {
            "type": "boolean"
          }
        }
      },
      "ApiResponseCompanyResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CompanyResponse"
          }
        }
      },
      "CompanyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "PENDING",
              "VERIFIED",
              "REJECTED"
            ]
          },
          "logoUrl": {
            "type": "string"
          },
          "coverImageUrl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "taxCode": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "companySize": {
            "type": "integer",
            "format": "int32"
          },
          "foundedYear": {
            "type": "integer",
            "format": "int32"
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/LocationResponse"
          },
          "industry": {
            "$ref": "#/components/schemas/IndustryResponse"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        }
      },
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
