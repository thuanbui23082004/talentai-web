{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentAI — Company Service API",
    "description": "Microservice quản lý hồ sơ doanh nghiệp (Company Profile), quy trình xác minh doanh nghiệp (Verification), danh mục ngành nghề (Industries), và địa điểm (Locations) trên nền tảng tuyển dụng TalentAI.",
    "contact": {
      "name": "TalentAI Backend Team",
      "email": "backend@talentai.dev"
    },
    "license": {
      "name": "Private",
      "url": "https://talentai.dev"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Local Development"
    },
    {
      "url": "http://localhost:3000",
      "description": "API Gateway Routing"
    }
  ],
  "security": [
    {
      "Bearer Authentication": []
    }
  ],
  "tags": [
    {
      "name": "Health & Readiness",
      "description": "Endpoints kiểm tra trạng thái hoạt động của service"
    },
    {
      "name": "Admin Company Management",
      "description": "Kiểm duyệt và quản lý trạng thái xác thực doanh nghiệp dành cho Admin"
    },
    {
      "name": "Health & Readiness",
      "description": "Endpoints kiểm tra sức khỏe và độ sẵn sàng của service"
    },
    {
      "name": "Public Companies",
      "description": "Tìm kiếm và tra cứu chi tiết công ty công khai"
    },
    {
      "name": "Company Management",
      "description": "Endpoints quản lý hồ sơ doanh nghiệp, xác thực và danh mục"
    },
    {
      "name": "Recruiter Company",
      "description": "Quản lý hồ sơ công ty và gửi yêu cầu xác minh dành cho Recruiter"
    },
    {
      "name": "Master Data",
      "description": "Danh mục ngành nghề (Industries) và địa điểm (Locations)"
    }
  ],
  "paths": {
    "/api/v1/recruiter/company": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Lấy thông tin hồ sơ doanh nghiệp của Recruiter hiện tại",
        "description": "Trả về chi tiết công ty gắn liền với tài khoản Recruiter đang đăng nhập",
        "operationId": "getOwn",
        "responses": {
          "200": {
            "description": "Lấy hồ sơ doanh nghiệp thành công",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Yêu cầu quyền ROLE_RECRUITER",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Recruiter chưa khởi tạo thông tin doanh nghiệp",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      },
      "put": {
        "tags": [
          "Company Management"
        ],
        "summary": "Tạo mới hoặc cập nhật hồ sơ doanh nghiệp",
        "description": "Cho phép nhà tuyển dụng cập nhật thông tin tên, mô tả, website, quy mô, logo của công ty",
        "operationId": "upsert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanyUpsertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cập nhật hồ sơ công ty thành công",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu đầu vào không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Yêu cầu quyền ROLE_RECRUITER",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      }
    },
    "/api/v1/recruiter/company/verification": {
      "post": {
        "tags": [
          "Company Management"
        ],
        "summary": "Gửi yêu cầu xác thực doanh nghiệp",
        "description": "Nhà tuyển dụng gửi yêu cầu xác minh thông tin doanh nghiệp (chuyển sang trạng thái PENDING)",
        "operationId": "submit",
        "responses": {
          "200": {
            "description": "Gửi yêu cầu xác thực thành công",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Công ty đã được xác thực hoặc đang chờ duyệt",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Yêu cầu quyền ROLE_RECRUITER",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Chưa tạo hồ sơ công ty",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      }
    },
    "/api/v1/admin/companies/{id}/verification": {
      "patch": {
        "tags": [
          "Company Management"
        ],
        "summary": "Admin duyệt hoặc từ chối yêu cầu xác thực",
        "description": "Admin cập nhật trạng thái xác minh doanh nghiệp (VERIFIED hoặc REJECTED)",
        "operationId": "decide",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID của công ty",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationDecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cập nhật quyết định xác thực thành công",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Trạng thái phê duyệt không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Yêu cầu quyền ROLE_ADMIN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy công ty",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health & Readiness"
        ],
        "summary": "Readiness probe",
        "description": "Kiểm tra kết nối cơ sở dữ liệu để tiếp nhận traffic",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Database kết nối thành công, sẵn sàng nhận request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database không khả dụng, service chưa sẵn sàng",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health & Readiness"
        ],
        "summary": "Liveness probe",
        "description": "Kiểm tra service còn sống hay không",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service đang hoạt động bình thường",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/locations": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Lấy danh mục địa điểm",
        "description": "Danh sách tất cả các tỉnh/thành phố, địa điểm làm việc",
        "operationId": "locations",
        "responses": {
          "200": {
            "description": "Danh sách địa điểm",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListLocationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/industries": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Lấy danh mục ngành nghề",
        "description": "Danh sách tất cả các ngành nghề kinh doanh/hoạt động",
        "operationId": "industries",
        "responses": {
          "200": {
            "description": "Danh sách ngành nghề",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListIndustryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Tìm kiếm danh sách công ty công khai",
        "description": "Tìm kiếm các công ty đã đăng ký trên hệ thống theo từ khóa, ngành nghề, địa điểm và phân trang",
        "operationId": "searchCompanies",
        "parameters": [
          {
            "name": "request",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CompanySearchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách kết quả tìm kiếm phân trang",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageCompanySearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Xem thông tin chi tiết một công ty",
        "description": "Tra cứu thông tin công khai của doanh nghiệp theo ID",
        "operationId": "getPublic",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID của công ty",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết công ty",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy công ty với ID đã cung cấp",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/companies": {
      "get": {
        "tags": [
          "Company Management"
        ],
        "summary": "Admin tra cứu danh sách công ty theo trạng thái xác thực",
        "description": "Lấy danh sách các công ty kèm phân trang để xem xét phê duyệt",
        "operationId": "listForAdmin",
        "parameters": [
          {
            "name": "verificationStatus",
            "in": "query",
            "description": "Lọc theo trạng thái xác thực (PENDING, VERIFIED, REJECTED)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "UNVERIFIED",
                "PENDING",
                "VERIFIED",
                "REJECTED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Số trang (bắt đầu từ 0)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Số lượng phần tử mỗi trang",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách công ty phân trang",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyPageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Yêu cầu quyền ROLE_ADMIN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      }
    },
    "/api/v1/recruiter/company/logo": {
      "post": {
        "tags": [
          "Company Management"
        ],
        "operationId": "uploadLogo",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recruiter/company/cover": {
      "post": {
        "tags": [
          "Company Management"
        ],
        "operationId": "uploadCover",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCompanyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompanyUpsertRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "taxCode": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "website": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 0,
            "pattern": "(?i)https?://[^\\s]+"
          },
          "companySize": {
            "type": "integer",
            "format": "int32"
          },
          "foundedYear": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "contactEmail": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "contactPhone": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          "address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "locationId": {
            "type": "integer",
            "format": "int64"
          },
          "industryId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiResponseCompanyResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CompanyResponse"
          }
        }
      },
      "CompanyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "PENDING",
              "VERIFIED",
              "REJECTED"
            ]
          },
          "logoUrl": {
            "type": "string"
          },
          "coverImageUrl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "taxCode": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "companySize": {
            "type": "integer",
            "format": "int32"
          },
          "foundedYear": {
            "type": "integer",
            "format": "int32"
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/LocationResponse"
          },
          "industry": {
            "$ref": "#/components/schemas/IndustryResponse"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "IndustryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "VerificationDecisionRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "PENDING",
              "VERIFIED",
              "REJECTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ApiResponseListLocationResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationResponse"
            }
          }
        }
      },
      "ApiResponseListIndustryResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
