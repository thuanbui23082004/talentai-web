            "minLength": 0
          },
          "desiredLocation": {
            "type": "string",
            "description": "Địa điểm mong muốn làm việc",
            "example": "Hà Nội (Hybrid)",
            "maxLength": 200,
            "minLength": 0
          },
          "yearsOfExperience": {
            "type": "integer",
            "format": "int32",
            "description": "Tổng số năm kinh nghiệm làm việc",
            "example": 5
          },
          "jobSearchStatus": {
            "type": "string",
            "description": "Trạng thái tìm việc (ACTIVELY_LOOKING, OPEN_TO_OFFERS, NOT_LOOKING)",
            "example": "ACTIVELY_LOOKING",
            "maxLength": 30,
            "minLength": 0
          },
          "searchable": {
            "type": "boolean",
            "description": "Cho phép nhà tuyển dụng tìm thấy hồ sơ của bạn (tương đương is_public)",
