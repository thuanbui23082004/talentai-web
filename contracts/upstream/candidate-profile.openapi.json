        "description": "Xóa một mục kinh nghiệm làm việc theo ID.",
        "operationId": "deleteExperience",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Mã định danh (ID) của mục kinh nghiệm",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e"
