  "components": {
    "schemas": {
      "SkillsRequest": {
        "type": "object",
        "description": "Dữ liệu yêu cầu cập nhật danh sách kỹ năng",
        "properties": {
          "skills": {
            "type": "array",
            "description": "Danh sách kỹ năng chuyên môn",
            "example": [
              "Java",
              "Spring Boot",
              "PostgreSQL",
              "Docker",
              "Microservices"
            ],
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            },
            "minItems": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Nội dung chi tiết của lỗi",
        "properties": {
          "code": {
            "type": "string",
            "description": "Mã lỗi nghiệp vụ chuẩn (ví dụ: VALIDATION_FAILED, FILE_TOO_LARGE, PROFILE_NOT_FOUND)",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "Thông điệp mô tả lỗi",
            "example": "Dữ liệu đầu vào không hợp lệ"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Thời điểm xảy ra lỗi (ISO-8601 UTC)",
            "example": "2026-10-28T00:00:00Z"
          },
          "fieldErrors": {
            "type": "array",
            "description": "Danh sách chi tiết lỗi trên từng trường dữ liệu (nếu có)",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Cấu trúc phản hồi lỗi chuẩn của hệ thống",
