            "maxLength": 1000,
            "minLength": 0
          },
          "dob": {
            "type": "string",
            "format": "date-time",
            "description": "Ngày tháng năm sinh (ISO-8601 UTC)",
            "example": "1998-05-15T00:00:00Z"
          },
          "gender": {
            "type": "string",
            "description": "Giới tính (MALE, FEMALE, OTHER)",
            "example": "MALE",
            "maxLength": 10,
            "minLength": 0
          },
          "address": {
            "type": "string",
            "description": "Địa chỉ chi tiết nơi ở",
            "example": "Số 123 Đường Cầu Giấy, Phường Dịch Vọng, Quận Cầu Giấy",
            "maxLength": 500,
            "minLength": 0
          },
          "desiredJobTitle": {
            "type": "string",
            "description": "Vị trí công việc mong muốn ứng tuyển",
