            "maxLength": 200,
            "minLength": 0
          },
          "issuer": {
            "type": "string",
            "description": "Tổ chức cấp chứng chỉ",
            "example": "Amazon Web Services",
            "maxLength": 200,
            "minLength": 0
          },
          "credentialId": {
            "type": "string",
            "description": "Mã số chứng chỉ (Credential ID)",
            "example": "AWS-SAA-12345678",
            "maxLength": 200,
            "minLength": 0
          },
          "credentialUrl": {
            "type": "string",
            "description": "Đường dẫn tra cứu / xác thực chứng chỉ trực tuyến",
            "example": "https://www.credly.com/badges/sample-id",
            "maxLength": 1000,
            "minLength": 0
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Thời gian cấp chứng chỉ (ISO-8601 UTC)",
            "example": "2024-01-15T00:00:00Z"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Thời gian hết hạn của chứng chỉ (ISO-8601 UTC). Để null nếu vĩnh viễn",
            "example": "2027-01-15T00:00:00Z"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "securitySchemes": {
      "Bearer Authentication": {
        "type": "http",
        "description": "Nhập JWT Access Token (nhận từ Auth Service hoặc test token có role CANDIDATE)",
        "name": "Bearer Authentication",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
