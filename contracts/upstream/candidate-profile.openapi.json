            "$ref": "#/components/schemas/Error",
            "description": "Chi tiết thông tin lỗi"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "Chi tiết lỗi trên từng trường dữ liệu đầu vào",
