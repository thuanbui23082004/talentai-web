{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentAI — Profile Service API",
    "description": "Microservice quản lý hồ sơ ứng viên (Candidate Profile), kỹ năng (Skills), học vấn (Education), kinh nghiệm làm việc (Experience), chứng chỉ (Certificates), và tải lên/quản lý CV (Resumes) với kho lưu trữ đối tượng S3/MinIO cho nền tảng TalentAI.",
    "contact": {
      "name": "TalentAI Backend Team",
      "email": "backend@talentai.dev"
    },
    "license": {
      "name": "Private",
      "url": "https://talentai.dev"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Local Development"
    }
  ],
  "security": [
    {
      "Bearer Authentication": []
    }
  ],
  "tags": [
    {
      "name": "Candidate Resumes (CVs)",
      "description": "Quản lý tải lên CV, xem chi tiết, phân chia phiên bản và thiết lập CV mặc định"
    },
    {
      "name": "Candidate Education",
      "description": "Quản lý quá trình học vấn và bằng cấp"
    },
    {
      "name": "Candidate Experience",
      "description": "Quản lý kinh nghiệm và lịch sử làm việc"
    },
    {
      "name": "Health & Diagnostics",
      "description": "Kiểm tra tình trạng hoạt động và tính sẵn sàng của profile-service"
    },
    {
      "name": "Health & Diagnostics",
      "description": "Kiểm tra sức khỏe và độ sẵn sàng của service"
    },
    {
      "name": "Candidate Profile",
      "description": "Quản lý thông tin tổng quan hồ sơ ứng viên"
    },
    {
      "name": "Candidate Resumes (CVs)",
      "description": "Tải lên, quản lý phiên bản và đặt CV mặc định"
    },
    {
      "name": "Candidate Skills",
      "description": "Quản lý danh sách kỹ năng chuyên môn"
    },
    {
      "name": "Candidate Certificates",
      "description": "Quản lý chứng chỉ nghề nghiệp"
    }
  ],
  "paths": {
    "/api/v1/candidate/skills": {
      "get": {
        "tags": [
          "Candidate Skills"
        ],
        "summary": "Lấy danh sách kỹ năng chuyên môn",
        "description": "Trả về mảng danh sách các kỹ năng của ứng viên hiện tại.",
        "operationId": "getSkills",
        "responses": {
          "200": {
            "description": "Lấy danh sách kỹ năng thành công",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      },
      "put": {
        "tags": [
          "Candidate Skills"
        ],
        "summary": "Cập nhật danh sách kỹ năng",
        "description": "Thay thế toàn bộ danh sách kỹ năng hiện tại bằng danh sách mới. Hệ thống sẽ tự động chuẩn hóa: cắt khoảng trắng, loại bỏ chuỗi rỗng và lọc trùng lặp.",
        "operationId": "setSkills",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cập nhật danh sách kỹ năng thành công",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Danh sách kỹ năng rỗng hoặc có phần tử không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      }
    },
