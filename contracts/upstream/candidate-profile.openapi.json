          "code": {
            "type": "string",
            "description": "Mã lỗi trên trường",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "Thông báo lỗi cụ thể",
            "example": "must not be blank"
          }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "description": "Dữ liệu yêu cầu cập nhật hồ sơ cá nhân của ứng viên",
        "properties": {
          "fullName": {
            "type": "string",
            "description": "Họ và tên đầy đủ của ứng viên",
