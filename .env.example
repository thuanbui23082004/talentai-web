# Business data is mocked by default; auth and notifications still use the backend gateway.
DATA_MODE=mock
APPLICATION_DATA_MODE=mock
PROFILE_DATA_MODE=mock
COMPANY_DATA_MODE=mock
JOB_DATA_MODE=mock
MATCHING_DATA_MODE=mock

# Single server-side upstream for every real request. Required when DATA_MODE=real.
BACKEND_API_URL=http://localhost:3000/api/v1

# Public provider identifiers (not secrets). Restart dev / rebuild after editing.
# Google Cloud: Web OAuth client, Authorized JavaScript origin http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Meta: Facebook Login for Web, JavaScript SDK enabled, allowed site/domain configured.
NEXT_PUBLIC_FACEBOOK_APP_ID=
# Use the Graph API version configured for your Meta app.
NEXT_PUBLIC_FACEBOOK_API_VERSION=v25.0
