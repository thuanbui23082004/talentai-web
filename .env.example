# Mock dữ liệu nghiệp vụ trong BFF; auth luôn cần auth service thật.
DATA_MODE=mock
COMPANY_DATA_MODE=mock
COMPANY_API_URL=http://localhost:3003/api/v1
JOB_DATA_MODE=mock
JOB_API_URL=http://localhost:3004/api/v1

# Auth luôn gọi backend thật, độc lập với DATA_MODE của dữ liệu nghiệp vụ.
AUTH_API_URL=http://localhost:3001/api/v1

# Public provider identifiers (not secrets). Restart dev / rebuild after editing.
# Google Cloud: Web OAuth client, Authorized JavaScript origin http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Meta: Facebook Login for Web, JavaScript SDK enabled, allowed site/domain configured.
NEXT_PUBLIC_FACEBOOK_APP_ID=
# Use the Graph API version configured for your Meta app.
NEXT_PUBLIC_FACEBOOK_API_VERSION=v25.0

# Bắt buộc khi DATA_MODE=real; bao gồm prefix API của backend.
BACKEND_API_URL=http://localhost:8000/api
